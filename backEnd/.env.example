# Copie para .env e preencha. Nunca faça commit do .env.

# Banco (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=hire_dev
# true para ver o SQL no console
DB_LOGGING=false

# Autenticação — segredo com 32+ caracteres (o servidor não sobe sem ele)
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
# e-mails separados por vírgula: viram administradores (bootstrap do primeiro admin)
ADMIN_EMAILS=

# Pedidos sem resposta expiram depois de N horas
HIRE_EXPIRY_HOURS=48

# E-mail (sem SMTP_HOST, os e-mails vão para backEnd/outbox/*.html)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Endereços públicos
# site (links de e-mail, QR Code, canonical, Open Graph, sitemap)
FRONTEND_URL=http://localhost:5173
# backend visto de fora (imagens nas meta tags); com um domínio só, igual ao FRONTEND_URL
PUBLIC_API_URL=http://localhost:8080
PORT=8080

# SEO: pasta do build do frontend servida pelo backend (padrão: ../frontEnd/dist)
FRONTEND_DIST=
# páginas /servicos/<categoria>/<cidade> só são indexadas com pelo menos N prestadores
SEO_MIN_PROVIDERS=1

NODE_ENV=development

# Endereços do frontend liberados no CORS (separados por vírgula). Em produção com o build servido pelo Express, use o próprio domínio.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Taxa da plataforma sobre cada pagamento (%). Pagamentos são simulados.
PLATFORM_FEE_PERCENT=10

# Logs: uma linha JSON por evento (debug|info|warn|error). LOG_FORMAT=pretty deixa legível no terminal.
LOG_LEVEL=info

# Esquema do banco: em desenvolvimento o TypeORM sincroniza as tabelas sozinho.
# Em produção use DB_SYNC=false: as migrations de src/migrations rodam ao subir o servidor.
# Banco já criado pelo synchronize? Rode uma vez: npm run migration:baseline
DB_SYNC=true
# Backups: npm run backup (pasta backups/), mantém os BACKUP_KEEP mais recentes
BACKUP_KEEP=7
